@startuml C2-main
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.12.0/C4_Container.puml
 title C2. A — обработка на edge
Person(operator, "Оператор", "Местная работа")
Person(manager, "Управляющий", "Сводный мониторинг")
System_Ext(cameras, "Камеры", "Ночная съёмка")
System_Ext(equipment, "Оборудование", "Кормушки, поилки, датчики и фильтры")
System_Ext(alarm, "Сигнализация", "Местный световой и звуковой сигнал")
System_Ext(erp, "ERP 1С:Агро", "Существующий складской учёт")
System_Ext(data, "Корпоративная аналитика", "Существующие Kafka, ClickHouse и BI")
System_Boundary(edge, "Edge-мониторинг") {
 Container(video, "Видеоаналитика", "GStreamer Runtime", "Модель партнёров: поведение, состояние и подсчёт")
 Container(incident, "Сервис инцидентов", "gRPC / REST", "Выявление опасности и местное оповещение")
 Container(adapter, "Адаптеры оборудования", "Modbus / OPC UA", "Телеметрия и безопасное исполнение команд")
 ContainerDb(edb, "Локальные данные edge", "SQLite", "События, настройки; отдельные БД приложений")
}
System_Boundary(farm, "Агент фермы — один сервер") {
 Container(ui, "Местный UI/API", "HTTPS REST", "Роли и работа оператора")
 Container(feed, "Кормление и вода", "Сервис", "Расписания, фильтры, остатки и прогноз")
 Container(metrics, "Поголовье и метрики", "Сервис", "Учёт по загонам и собственные показатели")
 Container(broker, "Локальный брокер", "Mosquitto / MQTT", "События и команды")
 Container(sync, "Синхронизация", "HTTPS REST", "Сохранение событий, обмен с центром и настройки")
 ContainerDb(fdb, "Данные сервисов фермы", "PostgreSQL", "Отдельная схема или отдельная база для каждого сервиса")
}
System_Boundary(center, "Центральная система") {
 Container(api, "Центральный API", "HTTPS REST", "API клиентов и агентов")
 Container(farms, "Управление фермами", "Сервис", "Реестр и конфигурации")
 Container(monitor, "Сводный мониторинг", "Сервис", "События, показатели и корпоративные интеграции")
 Container(auth, "Служба доступа", "Keycloak / OIDC", "Пользователи и роли")
 ContainerDb(cdb, "Центральные данные", "PostgreSQL", "Раздельные данные сервисов и службы доступа (Отдельные схемы или базы)")
}
Rel(cameras, video, "Видео", "RTSP / ONVIF")
Rel(video, incident, "Наблюдения", "gRPC")
Rel(incident, alarm, "Немедленный сигнал", "Локальный адаптер")
Rel(alarm, operator, "Оповещение")
Rel(incident, edb, "Сохраняет события", "SQL")
BiRel(incident, broker, "События / настройки правил", "MQTT")
BiRel(adapter, equipment, "Команды / телеметрия", "Modbus / OPC UA")
Rel(adapter, edb, "Настройки и буфер", "SQL")
BiRel(adapter, broker, "Телеметрия / команды", "MQTT")
BiRel(feed, broker, "Команды / расход", "MQTT")
Rel(broker, metrics, "Наблюдения и расход", "MQTT")
BiRel(broker, sync, "События / настройки", "MQTT")
Rel(operator, ui, "Использует", "HTTPS")
Rel(ui, fdb, "Местные учётные записи", "SQL")
Rel(ui, feed, "Управляет", "REST")
Rel(ui, metrics, "Просматривает", "REST")
Rel(ui, incident, "Просмотр и подтверждение", "REST")
Rel(feed, fdb, "Свои данные", "SQL")
Rel(metrics, fdb, "Свои данные", "SQL")
Rel(sync, fdb, "Очередь синхронизации", "SQL")
BiRel(feed, sync, "Состояние / расписания", "REST")
BiRel(metrics, sync, "Показатели / правила метрик", "REST")
Rel(sync, api, "События; получает настройки", "HTTPS")
Rel(manager, api, "Через веб-/мобильный клиент", "HTTPS")
Rel(api, farms, "Настройки", "REST")
Rel(api, monitor, "События и отчёты", "REST")
Rel(api, auth, "Аутентификация", "OIDC")
Rel(ui, auth, "Вход онлайн; местный доступ офлайн", "OIDC")
Rel(auth, cdb, "Свои данные", "SQL")
Rel(farms, cdb, "Свои данные", "SQL")
Rel(monitor, cdb, "Свои данные", "SQL")
BiRel(monitor, erp, "Остатки и расход", "REST")
Rel(monitor, data, "События и метрики", "Kafka")
@enduml
