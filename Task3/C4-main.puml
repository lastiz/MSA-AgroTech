@startuml C4-main
title C4. Сервис инцидентов — edge-устройство
skinparam classAttributeIconSize 0
hide empty members
class ObservationController {
 +receive(observation): void
}
class IncidentService {
 +process(observation): void
 +acknowledge(id): void
}
class Incident {
 +id: UUID
 +type: String
 +zoneId: String
 +status: String
}
class IncidentRepository <<SQLite>> {
 +save(incident): void
 +findPending(): List<Incident>
 +markSent(id): void
}
class LocalNotifier {
 +notify(incident): void
}
class EventPublisher {
 +sendPending(): void
}
ObservationController --> IncidentService
IncidentService --> Incident : создаёт
IncidentService --> IncidentRepository : сохраняет
IncidentService --> LocalNotifier : оповещает
EventPublisher --> IncidentRepository : получает события
note bottom of EventPublisher
 Передаёт события через MQTT.
 Повторяет отправку при сбое связи.
end note
note bottom of LocalNotifier
 Работает без сервера фермы.
end note
@enduml
